# PostgreSQL — Row-Level Security ready (see prisma/rls.sql)
DATABASE_URL="postgresql://subtrack:subtrack@localhost:5432/subtrack_vip?schema=public"

# Deterministic mock-data seed. Same seed => byte-identical demo dataset.
SUBTRACK_MOCK_SEED="1071"

# Provider selection: "mock" | "aoh" | "paycell" | "finrota"
SUBTRACK_BANK_PROVIDER="mock"
